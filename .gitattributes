#include <iostream>
#include <string>
using namespace std;

int main() {
    const int jumlah = 5; // jumlah maksimal mahasiswa
    string nama[jumlah];

    // Input nama mahasiswa
    cout << "Masukkan " << jumlah << " nama mahasiswa:\n";
    cin.ignore(); // buang newline tersisa sebelum getline
    for (int i = 0; i < jumlah; i++) {
        cout << "Mahasiswa ke-" << i+1 << ": ";
        getline(cin, nama[i]);
    }

    // Tampilkan semua nama
    cout << "\nDaftar Mahasiswa:\n";
    for (int i = 0; i < jumlah; i++) {
        cout << i+1 << ". " << nama[i] << endl;
    }

    // Cari nama mahasiswa
    string cari;
    cout << "\nMasukkan nama yang ingin dicari: ";
    getline(cin, cari);

    bool ketemu = false;
    for (int i = 0; i < jumlah; i++) {
        if (nama[i] == cari) {
            cout << "Nama \"" << cari << "\" ditemukan pada indeks ke-" << i << endl;
            ketemu = true;
            break;
        }
    }

    if (!ketemu) {
        cout << "Nama \"" << cari << "\" tidak ditemukan dalam array.\n";
    }

    return 0;
}
